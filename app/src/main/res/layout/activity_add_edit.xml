<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sand">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/sand"
        android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/forest"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
            app:titleTextColor="@color/sand" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="24dp">

                <TextView
                    android:id="@+id/formTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:text="Add Trail"
                    android:textColor="@color/forest"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="40dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="10dp"
                    android:background="@color/trail_orange" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_outline"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/Widget.HikingHub.FieldLabel"
                        android:layout_marginTop="0dp"
                        android:text="Name" />

                    <EditText
                        android:id="@+id/nameInput"
                        style="@style/Widget.HikingHub.EditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:hint="Trail name"
                        android:inputType="text" />

                    <TextView
                        style="@style/Widget.HikingHub.FieldLabel"
                        android:text="Description" />

                    <EditText
                        android:id="@+id/descriptionInput"
                        style="@style/Widget.HikingHub.EditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="top"
                        android:hint="What makes this trail special?"
                        android:inputType="textMultiLine"
                        android:minLines="3" />

                    <TextView
                        style="@style/Widget.HikingHub.FieldLabel"
                        android:text="Location" />

                    <EditText
                        android:id="@+id/locationInput"
                        style="@style/Widget.HikingHub.EditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:hint="Where is it?"
                        android:inputType="text" />

                    <TextView
                        style="@style/Widget.HikingHub.FieldLabel"
                        android:text="Difficulty" />

                    <Spinner
                        android:id="@+id/difficultyInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_outline"
                        android:minHeight="48dp"
                        android:popupBackground="@drawable/bg_outline_sand" />

                    <TextView
                        style="@style/Widget.HikingHub.FieldLabel"
                        android:text="Distance (km)" />

                    <EditText
                        android:id="@+id/distanceInput"
                        style="@style/Widget.HikingHub.EditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:hint="e.g. 8.5"
                        android:inputType="numberDecimal" />

                    <TextView
                        style="@style/Widget.HikingHub.FieldLabel"
                        android:gravity="center_horizontal"
                        android:text="Rating" />

                    <RatingBar
                        android:id="@+id/ratingInput"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="6dp"
                        android:numStars="5"
                        android:progressTint="@color/trail_orange"
                        android:secondaryProgressTint="@color/trail_orange"
                        android:rating="0"
                        android:stepSize="1.0" />

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/saveButton"
                    style="@style/Widget.HikingHub.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_marginTop="24dp"
                    android:text="Save" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cancelButton"
                    style="@style/Widget.HikingHub.Button.Outline"
                    android:layout_width="match_parent"
                    android:layout_marginTop="12dp"
                    android:text="Cancel" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navView"
        style="@style/Widget.HikingHub.NavigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/nav_drawer" />

</androidx.drawerlayout.widget.DrawerLayout>
