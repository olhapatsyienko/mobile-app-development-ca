<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Ca" parent="Theme.MaterialComponents.Light.NoActionBar" />

    <style name="Widget.HikingHub.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_height">54dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">14dp</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.HikingHub.Button.Primary">
        <item name="backgroundTint">@color/trail_orange</item>
        <item name="android:textColor">@color/sand</item>
    </style>

    <style name="Widget.HikingHub.Button.Outline" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_height">54dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/forest</item>
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">@color/forest</item>
        <item name="strokeWidth">2dp</item>
        <item name="backgroundTint">@android:color/transparent</item>
    </style>

</resources>